# Copiá este archivo a ".env" y completá tus API keys reales.
# El ".env" NO se sube a git (ver .gitignore).

# API key de OpenAI: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# API key de Anthropic: https://console.anthropic.com/settings/keys
# (importante: es distinta de tu login/suscripción de claude.ai)
ANTHROPIC_API_KEY=sk-ant-...

# Opcional: proveedor por defecto si no se especifica en el código ("openai" o "anthropic")
LLM_PROVIDER=openai
